{
	"name": "glide-monorepo",
	"private": true,
	"packageManager": "pnpm@10.33.4",
	"scripts": {
		"setup": "pnpm install",
		"build": "turbo run build",
		"dev": "turbo run dev --parallel",
		"lint": "turbo run lint",
		"lint:mobile": "pnpm --filter @glide/mobile lint",
		"lint:web": "pnpm --filter @glide/web lint",
		"test": "turbo run test",
		"test:mobile": "pnpm --filter @glide/mobile test",
		"test:web": "pnpm --filter @glide/web test",
		"mobile": "pnpm --filter @glide/mobile dev",
		"web": "pnpm --filter @glide/web dev",
		"typecheck": "turbo run typecheck"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.19.39",
		"eslint": "^9.39.4",
		"jest": "^29.7.0",
		"ts-jest": "^29.4.15",
		"turbo": "^2.11.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.0"
	},
	"pnpm": {
		"overrides": {
			"ws@6.2.3": "6.2.4",
			"ws@7.5.10": "7.5.11",
			"ws@8.20.0": "8.21.0",
			"brace-expansion@1.1.13": "1.1.21",
			"brace-expansion@5.0.5": "5.0.12",
			"js-yaml@3.14.2": "3.15.2",
			"js-yaml@4.1.1": "4.3.2",
			"@babel/core@7.29.0": "7.29.6",
			"nanoid@3.3.11": "3.3.18",
			"baseline-browser-mapping@2.10.15": "2.11.0",
			"postcss@8.5.8": "8.5.23",
			"@xmldom/xmldom@0.8.12": "0.8.15",
			"@tootallnate/once@2.0.0": "2.0.1",
			"shell-quote@1.8.3": "1.11.0",
			"form-data@4.0.5": "4.0.6",
			"@humanfs/node@0.16.7": "0.16.8",
			"fflate@0.8.2": "0.8.3",
			"source-map-js@1.2.1": "1.2.2",
			"@babel/helper-compilation-targets>browserslist": "4.29.4"
		}
	}
}
