{
  "servers": {
    "test-sprite": {
      "command": "npx",
      "args": [
        "=y"
        "@testsprite/testsprite-mcp@latest"
      ],
      "env": {
        "API_KEY": "${TESTSPRITE_API_KEY}"
      }
    },
    "next-devtools": {
      "command": "npx",
      "args": [
         "-y",
         "next-devtools-mcp@latest"
      ]
    },
    "npm-sentinel": {
      "command": "npx",
      "args": [
        "-y",
        "@nekzus/mcp-server@latest"
      ]
    }
  }
}
